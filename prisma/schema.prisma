// -------------------------------------- new models for this project --------------------------------------

model DailyCheckIn {
  id             String   @id @default(cuid())
  created_at     DateTime @default(now())
  last_active_at DateTime @default(now())

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("daily_check_ins")
}

model Category {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  title  String
  videos Video[]

  @@map("categories")
}

// enum Level {
//   BEGINNER
//   INTERMEDIATE
//   ADVANCE
// }

enum VideoStatus {
  UPLOADING
  DRAFT
  PUBLISHED
}

model Video {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  title         String?
  url           String?
  thumbnail_url String?
  description   String?
  // level         Level?
  category_id   String?
  status        VideoStatus @default(UPLOADING)
  duration      Int? // in seconds

  category               Category?              @relation(fields: [category_id], references: [id], onDelete: SetNull)
  favorite_videos        FavoriteVideo[]
  watch_histories        WatchHistory[]
  prescription_videos    PrescriptionVideo[]
  prescription_templates PrescriptionTemplate[]

  @@map("videos")
}

