model WatchHistory {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user_id              String?
  video_id             String?
  prescription_id      String?
  is_completed         Boolean @default(false)
  last_played_position Int? // in seconds

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  video        Video?        @relation(fields: [video_id], references: [id], onDelete: Cascade)
  prescription Prescription? @relation("PrescriptionWatchHistory", fields: [prescription_id], references: [id], onDelete: SetNull)

  @@map("watch_histories")
}

model PrescriptionTemplate {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  title  String
  videos Video[]

  @@map("prescription_templates")
}

model Prescription {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  title    String
  videos   PrescriptionVideo[]
  patients Patient[]
  watch_histories WatchHistory[] @relation("PrescriptionWatchHistory")

  @@map("prescriptions")
}

model PrescriptionVideo {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  reps   String?
  sets   String?
  weight String?
  note   String?

  prescription_id String
  video_id        String

  prescription Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  video        Video        @relation(fields: [video_id], references: [id], onDelete: Cascade)

  @@map("prescription_videos")
}

model Patient {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  prescription_id String
  user_id         String

  prescription Prescription @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("patients")
}

